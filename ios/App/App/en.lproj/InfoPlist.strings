/*
  The app is localized in English and Arabic: this file and its twin in ar.lproj
  are what make the bundle declare both, which is what the App Store's
  "Languages" line reads (ASO-1.0.1). The name under the icon stays KnowFlow
  in both languages, as Info.plist sets it.
*/
"CFBundleDisplayName" = "KnowFlow";

/* The camera screen ("Scan pages"). Approved 2026-11-18: docs/copy/ARABIC_STRINGS_app_v11.md. */
"NSCameraUsageDescription" = "KnowFlow uses the camera only when you photograph pages of your book or notebook, so it can read their text.";

/* Voice input in Ask (iOS 1.1, item 4e). Approved 2026-11-19: docs/copy/ARABIC_STRINGS_app_v13.md. */
"NSMicrophoneUsageDescription" = "KnowFlow uses the microphone only when you tap the microphone in Ask, to turn your spoken question into text you can edit before sending.";
"NSSpeechRecognitionUsageDescription" = "Apple's speech recognition turns your spoken question into text, on your phone when it can. KnowFlow never keeps the recording.";
