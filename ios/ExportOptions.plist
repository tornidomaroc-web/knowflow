<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Read by `xcodebuild -exportArchive` in .github/workflows/ios-testflight.yml
	     (docs/store/STORE_PATH.md T4, copied from Scan & Action's measured
	     pipeline, §8.4). method app-store-connect + destination upload: Xcode
	     signs the archive with the cloud-managed Apple Distribution certificate
	     and uploads it to App Store Connect itself, authenticated by the same
	     API key as the archive step. No altool, no Transporter, no certificate
	     in secrets.
	     App Store eligible: testFlightInternalTestingOnly was removed on
	     2026-10-17, so every build exported from here can be attached to an App
	     Store version (builds 1 to 6 carried it and never can). Attaching a
	     build to a version, and submitting it, each needs the owner's word.
	     manageAppVersionAndBuildNumber: Xcode bumps a stale CFBundleVersion in
	     the staged copy at upload, the safety net behind the run number and the
	     pre-archive check of the highest build App Store Connect already holds. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string>NQ23SMHXJV</string>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<true/>
</dict>
</plist>
